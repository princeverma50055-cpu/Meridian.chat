# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/meridian

# --- Auth ---
AUTH_SECRET=replace-with-a-random-32-byte-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI Provider ---
# One of: anthropic | google | openai
MERIDIAN_MODEL_PROVIDER=google
# Holds whichever provider's key above points to — Anthropic key if provider=anthropic,
# Gemini API key (from https://aistudio.google.com/apikey) if provider=google.
AI_PROVIDER_KEY=

# --- Web Search (for research / citations) ---
# Tavily — https://tavily.com (free tier: 1,000 credits/month, no credit card)
SEARCH_API_KEY=

# --- File Storage ---
# Vercel Blob — created automatically via Vercel dashboard → Storage → Blob.
# BLOB_READ_WRITE_TOKEN is added automatically when you connect the store to this project.
BLOB_READ_WRITE_TOKEN=

# --- Embeddings (required for file upload / RAG search) ---
# Voyage AI is Anthropic's recommended embeddings partner since Claude has no embeddings endpoint.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Vector Database (RAG / knowledge bases) ---
# Uses pgvector on the same Postgres database above — run:
#   CREATE EXTENSION IF NOT EXISTS vector;
# before `npm run db:push`. VECTOR_DATABASE_URL is only needed if you split embeddings into a
# separate database/service later.
VECTOR_DATABASE_URL=
